import { Request, Response } from 'express'; // Importamos tipos de Express para el request y response
import { PrismaClient } from '@prisma/client'; // Importamos el cliente de Prisma para interactuar con la BD

const prisma = new PrismaClient(); // Instanciamos el cliente de Prisma

// Función para crear un nuevo dueño de comercio
export const createMerchantOwner = async (req: Request, res: Response) => {
  try {
    // Extraemos los datos enviados desde el cliente (Frontend/Postman)
    const { pubkey, email, name, embeddedWalletPda } = req.body;

    // Usamos Prisma para insertar un nuevo registro en la tabla MerchantOwner
    const newOwner = await prisma.merchantOwner.create({
      data: {
        pubkey,            // Llave pública del usuario (tipo String)
        email,             // Email opcional
        name,              // Nombre opcional
        embeddedWalletPda  // Dirección de la wallet embebida (pda)
      },
    });

    // Si todo sale bien, respondemos con el objeto creado y un código 201 (Creado)
    res.status(201).json({ status: 'success', data: newOwner });
  } catch (error) {
    // Si algo falla, atrapamos el error y lo enviamos al cliente
    res.status(400).json({ status: 'error', message: 'No se pudo crear el dueño', error });
  }
};

// Nueva función para crear un comercio
export const createMerchant = async (req: Request, res: Response) => {
  try {
    // req.body ahora contiene { name, description, ownerId }
    const newMerchant = await prisma.merchant.create({
      data: req.body,
    });

    res.status(201).json({ status: 'success', data: newMerchant });
  } catch (error) {
    res.status(400).json({ status: 'error', message: 'No se pudo crear el comercio', error });
  }
};

// Función para crear una terminal vinculada a un comercio
export const createTerminal = async (req: Request, res: Response) => {
  try {
    // Recibimos terminalId, merchantId e isActive
    const newTerminal = await prisma.posTerminal.create({
  data: req.body,
});

    res.status(201).json({ status: 'success', data: newTerminal });
  } catch (error) {
    res.status(400).json({ status: 'error', message: 'No se pudo crear la terminal', error });
  }
};

// Función para crear un Pago
export const createPayment = async (req: Request, res: Response) => {
  try {
    // Usamos el modelo Payment correctamente
    const newPayment = await prisma.payment.create({
      data: req.body,
    });

    res.status(201).json({ status: 'success', data: newPayment });
  } catch (error) {
    res.status(400).json({ status: 'error', message: 'No se pudo registrar el pago', error });
  }
};


