# Copiar a .env y completar. NUNCA versionar el .env real.
# backend/ levanta DOS procesos independientes: el relayer (src/server.ts) y
# la API de catálogo (src/catalogServer.ts). Ambos leen este mismo .env.

# ── Relayer ──
RPC_URL=https://api.devnet.solana.com
PORT=3001
KEYS_DIR=.keys
DATA_DIR=data
RELAYER_DAILY_LAMPORTS_CAP=100000000
MAX_PRIORITY_MICROLAMPORTS=0
ALLOWED_ORIGINS=*
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=30
TRUSTED_PROXY_HOPS=0

# Credencial de operador: alta y actualización de comercios on-chain.
ADMIN_API_KEY=

# URL pública del relayer (QR de Solana Pay, campo `resource`).
PUBLIC_BASE_URL=http://localhost:3001

# Pubkey de la plataforma (owner on-chain de todos los merchants). Si se omite
# se deriva de KEYS_DIR/owner.json.
PLATFORM_OWNER_PUBKEY=

# ── x402 (opcional; sin estas tres la capa no se monta) ──
X402_FACILITATOR_URL=
X402_TREASURY=
X402_NETWORK=solana-devnet
X402_ASSET=
X402_PRICE_QR=1000
X402_PRICE_STATS=5000

# ── API de catálogo (Prisma / PostgreSQL) ──
DATABASE_URL=postgresql://usuario:password@localhost:5432/latamlink
API_PORT=3002

# Credencial general de la API de catálogo (backoffice y frontend del lado
# servidor). Sin ella el endpoint responde 503 en lugar de quedar abierto.
API_KEY=

# Credencial exclusiva del relayer: es la única que puede registrar un pago en
# el historial, para que no se puedan inventar cobros confirmados.
RELAYER_API_KEY=

# ── Conciliador (backend/scripts/conciliador.ts) ──
# Habla con la API de catálogo para registrar los cobros por QR, que llegan
# directo desde la billetera del cliente y nunca pasan por el relayer.
CATALOG_API_URL=http://localhost:3002
CATALOG_RELAYER_KEY=
