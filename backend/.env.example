# Copia a .env y ajusta. NUNCA commitear .env ni keypairs.
RPC_URL=https://api.devnet.solana.com
PORT=3000

# Directorio con los keypairs (generados por pnpm run setup:devnet).
# Contiene relayer (fee payer) y owner (wallet de la PLATAFORMA: es el owner
# on-chain de todos los merchants y la única que puede retirar el gas_vault).
KEYS_DIR=.keys

# Registro local de pagos para conciliación (ignorado por git).
DATA_DIR=data

# Credencial de operador para /merchants y /payments. Sin ella esos endpoints
# quedan deshabilitados (503), nunca abiertos. Generá una larga y aleatoria.
ADMIN_API_KEY=

# Pubkey de la wallet de la plataforma (owner de todos los comercios). Si se
# omite se toma de KEYS_DIR/owner.json. El relayer solo subsidia pagos a
# comercios cuyo owner sea esta wallet.
PLATFORM_OWNER_PUBKEY=

# Límite diario de gasto del relayer en lamports (anti-abuso).
# Solo dígitos: "100_000_000" o "0.1 SOL" hacen fallar el arranque a propósito.
RELAYER_DAILY_LAMPORTS_CAP=100000000

# Fee de prioridad máximo aceptado en una tx del cliente (micro-lamports por
# unidad de cómputo). 0 = el relayer no paga fees de prioridad ajenas.
MAX_PRIORITY_MICROLAMPORTS=0

# Rate limiting por IP
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=30

# Proxies propios delante del backend. 0 = no confiar en X-Forwarded-For
# (si se confía en cualquiera, el rate limiting se evade con una cabecera).
TRUSTED_PROXY_HOPS=0

# Orígenes permitidos para el frontend (coma-separados). "*" solo en devnet.
# Ej. producción: https://app.latamlink.xyz,https://pos.latamlink.xyz
ALLOWED_ORIGINS=*

# URL pública del backend (QRs de Solana Pay y campo `resource` de x402).
PUBLIC_BASE_URL=http://localhost:3000

# ── Conciliador de cobros ──
# Registra en el historial los pagos por QR, que envía la billetera del cliente
# y por eso el backend nunca ve. Se ejecuta con `pnpm run conciliador`.
CATALOG_API_URL=http://localhost:3002
CATALOG_RELAYER_KEY=

# ── Capa x402 (Fase 2) ──
# Sin estas tres variables la capa NO se monta: no se expone un paywall que no
# pueda verificar pagos. La tesorería x402 es una wallet DISTINTA del relayer.
X402_FACILITATOR_URL=
X402_TREASURY=
X402_ASSET=
X402_NETWORK=solana-devnet
# Precios por request, en unidades mínimas del token (6 decimales)
X402_PRICE_QR=1000
X402_PRICE_STATS=5000
