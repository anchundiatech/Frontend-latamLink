# Reglas propias del backend del relayer. El .gitignore de la raíz ya cubre
# node_modules y .env*; aquí se re-incluye el ejemplo y se protegen los
# artefactos locales que este servicio genera.
!.env.example

# Keypairs: NUNCA se versionan
.keys/

# Registros locales (pagos y comprobantes x402) y estado de devnet
data/
devnet-state.json

dist/
*.tsbuildinfo
node_modules/
.env
dist/

# Cliente de Prisma generado (output custom en prisma/schema.prisma): se
# regenera en cada install/build, no se versiona.
generated/
# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.env
AGENTS.md
CLAUDE.md
.data/
