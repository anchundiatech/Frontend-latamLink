generator client {
  provider = "prisma-client-js"
  // Con pnpm, la ubicación default (node_modules/.prisma/client) es ambigua:
  // el paquete @prisma/client trae empaquetado un placeholder con el mismo
  // nombre que revienta en runtime ("did not initialize yet") si Node
  // resuelve ese en vez del generado. Generar a una carpeta propia evita
  // la resolución ambigua por completo.
  output = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model MerchantOwner {
  id                  String     @id @default(uuid())
  pubkey              String     @unique
  email               String?    
  name                String?
  embeddedWalletPda   String     @unique @map("embedded_wallet_pda")
  createdAt           DateTime   @default(now())

  merchants           Merchant[]
}

model Merchant {
  id                  String     @id @default(uuid())
  merchantOwnerId     String
  merchantIdOnchain   BigInt     @unique @map("merchant_id_onchain")
  pdaAddress          String     @unique @map("pda_address")
  pdaPaymentVault     String     @map("pda_payment_vault")
  pdaGasVault         String     @map("pda_gas_vault")
  name                String
  feeBps              Int        @default(0) @map("fee_bps")
  posFeeBps           Int        @default(0) @map("pos_fee_bps")
  minPaymentAmount    BigInt     @default(0) @map("min_payment_amount")
  isActive            Boolean    @default(true) @map("is_active")
  totalVolume         BigInt     @default(0) @map("total_volume")
  createdAt           DateTime   @default(now())

  owner               MerchantOwner          @relation(fields: [merchantOwnerId], references: [id])
  destinations        MerchantDestination[]
  terminals           PosTerminal[]
  payments            Payment[]
}

model MerchantDestination {
  id                 String     @id @default(uuid())
  merchantId         String
  destinationPubkey  String     @map("destination_pubkey")
  percentage         Int
  positionIndex      Int        @map("position_index")
  isActive           Boolean    @default(true) @map("is_active")
  description        String?    @map("description")
  createdAt          DateTime   @default(now())

  merchant           Merchant   @relation(fields: [merchantId], references: [id])

  @@unique([merchantId, destinationPubkey])
}

model PosTerminal {
  id                  String     @id @default(uuid())
  merchantId          String
  posTerminalId       String     @db.VarChar(32) @map("pos_terminal_id")
  accessToken         String     @default(uuid()) @unique @map("access_token")
  isActive            Boolean    @default(true) @map("is_active")
  createdAt           DateTime   @default(now())

  merchant            Merchant   @relation(fields: [merchantId], references: [id])
  payments            Payment[]

  @@unique([merchantId, posTerminalId])
}

enum PaymentStatus {
  PENDING
  CONFIRMED
  FAILED
}

model Payment {
  id                  String        @id @default(uuid())
  txSignature         String        @unique @map("tx_signature")
  merchantId          String
  posTerminalId       String
  payerPubkey         String        @map("payer_pubkey")
  amountGross         BigInt        @map("amount_gross")
  posFee              BigInt        @map("pos_fee")
  gasFee              BigInt        @map("gas_fee")
  dust                BigInt
  timestamp           DateTime
  status              PaymentStatus @default(PENDING)

  merchant            Merchant      @relation(fields: [merchantId], references: [id])
  terminal            PosTerminal   @relation(fields: [posTerminalId], references: [id])
}

enum RelayerPaymentStatus {
  PENDING
  CONFIRMED
}

// Espejo en Postgres de lo que antes era backend/data/payments.jsonl: log
// append-only del relayer (identifica merchant/payer por pubkey, no por FK a
// Merchant, porque el relayer no depende del catálogo). Nunca se actualiza
// una fila; "pending" → "confirmed" se resuelve tomando el registro más
// reciente por signature, igual que antes con el archivo.
model RelayerPaymentLog {
  id          String               @id @default(uuid())
  signature   String               @map("signature")
  slot        Int?
  merchant    String
  payer       String
  amount      String
  reference   String?
  status      RelayerPaymentStatus
  createdAt   DateTime             @default(now()) @map("created_at")

  @@index([signature])
  @@index([merchant])
  @@index([reference])
  @@map("relayer_payment_log")
}

// Espejo en Postgres de backend/data/x402-receipts.jsonl. `distributed` queda
// en false al crearse: el job de liquidación de Fase 3 que lo marcaría en
// true todavía no existe (ver x402/routes.ts).
model X402ReceiptLog {
  id          String   @id @default(uuid())
  resource    String
  amount      String
  payer       String?
  transaction String?
  settledAt   DateTime @map("settled_at")
  distributed Boolean  @default(false)

  @@index([transaction])
  @@map("x402_receipt_log")
}