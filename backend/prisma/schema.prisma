generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model MerchantOwner {
  id                String     @id @default(uuid())
  pubkey            String     @unique
  email             String?
  name              String?
  embeddedWalletPda String     @unique
  createdAt         DateTime   @default(now())
  merchants         Merchant[]
}

model Merchant {
  id                String                @id @default(uuid())
  merchantOwnerId   String
  merchantOwner     MerchantOwner         @relation(fields: [merchantOwnerId], references: [id])
  merchantIdOnchain BigInt                @unique
  pdaAddress        String                @unique
  pdaPaymentVault   String
  pdaGasVault       String
  name              String
  feeBps            Int                   @default(0)
  posFeeBps         Int                   @default(0)
  minPaymentAmount  BigInt
  isActive          Boolean               @default(true)
  totalVolume       BigInt                @default(0)
  createdAt         DateTime              @default(now())
  destinations      MerchantDestination[]
  terminals         PosTerminal[]
  payments          Payment[]
}

model MerchantDestination {
  id                String   @id @default(uuid())
  merchantId        String
  merchant          Merchant @relation(fields: [merchantId], references: [id])
  destinationPubkey String
  percentage        Int
  positionIndex     Int
  isActive          Boolean  @default(true)
  description       String?
  createdAt         DateTime @default(now())

  @@unique([merchantId, destinationPubkey])
}

model PosTerminal {
  id            String    @id @default(uuid())
  merchantId    String
  merchant      Merchant  @relation(fields: [merchantId], references: [id])
  posTerminalId String
  accessToken   String    @default(uuid())
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  payments      Payment[]

  @@unique([merchantId, posTerminalId])
}

enum PaymentStatus {
  PENDING
  CONFIRMED
  FAILED
}

model Payment {
  id            String        @id @default(uuid())
  txSignature   String        @unique
  merchantId    String
  merchant      Merchant      @relation(fields: [merchantId], references: [id])
  posTerminalId String
  terminal      PosTerminal   @relation(fields: [posTerminalId], references: [id])
  payerPubkey   String
  amountGross   BigInt
  posFee        BigInt
  gasFee        BigInt
  dust          BigInt
  timestamp     DateTime
  status        PaymentStatus @default(PENDING)
  createdAt     DateTime      @default(now())
}
