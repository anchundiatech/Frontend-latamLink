{
  "name": "latamlink-backend",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "description": "Backend LatamLink Pay: relayer gasless (fee payer) + capa x402 sobre el programa latamlink_pay",
  "type": "module",
  "scripts": {
    "dev": "tsx src/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "setup:devnet": "tsx scripts/setup-devnet.ts",
    "e2e": "tsx scripts/e2e-pago.ts",
    "e2e:qr": "tsx scripts/e2e-qr.ts",
    "e2e:db": "tsx scripts/e2e-persistencia.ts",
    "bench": "tsx scripts/bench-pago.ts",
    "tesoreria:gas": "tsx scripts/tesoreria-gas.ts"
  },
  "dependencies": {
    "@solana/spl-token": "^0.4.9",
    "@solana/web3.js": "^1.95.8",
    "dotenv": "^16.4.5",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.17.9",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
