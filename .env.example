# Copiar a .env y completar. NUNCA versionar el .env real.
# El repo levanta tres procesos: la app Next, la API de catálogo y el relayer
# (este último tiene su propio .env en backend/, ver backend/.env.example).

# ── App Next (variables públicas: llegan al navegador) ──
NEXT_PUBLIC_CLUSTER=devnet
NEXT_PUBLIC_RPC_URL=https://api.devnet.solana.com
NEXT_PUBLIC_PROGRAM_ID=GSeGuv2K3meepgSHCehP5jGkRnjRZk96a9vsPSSJ7TjC
NEXT_PUBLIC_PRIVY_APP_ID=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Correos con acceso al panel de administración. Al ser NEXT_PUBLIC_ viaja al
# navegador: sirve para ocultar la sección, NO como control de acceso real.
NEXT_PUBLIC_ADMIN_EMAILS=

# ── Servidor (nunca se exponen al navegador) ──
RESEND_API_KEY=

# Base de datos de la API de catálogo (Prisma)
DATABASE_URL=postgresql://usuario:password@localhost:5432/latamlink

# Credencial de servicio de la API de catálogo. Sin ella la API responde 503 en
# lugar de quedar abierta. Generar una larga y aleatoria.
API_KEY=

# Credencial exclusiva del relayer: solo con ella se puede registrar un pago en
# el historial, para que no se puedan inventar cobros.
RELAYER_API_KEY=

# Puerto de la API de catálogo (Next usa el 3000 y el relayer el 3001)
API_PORT=3002

# RPC usado por la API para verificar que un pago exista realmente en la red
RPC_URL=https://api.devnet.solana.com

# Tesorería que patrocina el alta de comercios desde el frontend. Queda como
# transición: con el alta a través del relayer (POST /merchants) el comercio ya
# no necesita SOL y esta variable deja de hacer falta.
TREASURY_SECRET_KEY=
