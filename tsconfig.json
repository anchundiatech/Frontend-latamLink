{
  "compilerOptions": {
    // ES2020 habilita los literales BigInt, necesarios para trabajar con
    // importes on-chain sin perder precisión (los montos son u64).
    "target": "ES2020",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  // `backend/` es un servicio Node aparte, con su propio tsconfig (ES2022) y su
  // propia comprobación de tipos en CI. Sin excluirlo, el build de Next lo
  // type-chequea con esta configuración (ES2017) y falla, por ejemplo, en los
  // literales BigInt que usa para los montos.
  "exclude": ["node_modules", "backend"]
}
