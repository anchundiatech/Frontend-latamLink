# Copiar a .env y completar. NUNCA versionar el .env real.
# Next.js carga .env desde esta carpeta (Frontend/), no desde la raíz del
# repo ni desde backend/ (que tiene su propio .env.example).

# ── Variables públicas: llegan al navegador ──
NEXT_PUBLIC_CLUSTER=devnet
NEXT_PUBLIC_RPC_URL=https://api.devnet.solana.com
NEXT_PUBLIC_PROGRAM_ID=GSeGuv2K3meepgSHCehP5jGkRnjRZk96a9vsPSSJ7TjC
NEXT_PUBLIC_PRIVY_APP_ID=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Correos con acceso al panel de administración. Al ser NEXT_PUBLIC_ viaja al
# navegador: sirve para ocultar la sección, NO como control de acceso real.
NEXT_PUBLIC_ADMIN_EMAILS=

# ── Servidor (nunca se exponen al navegador; usadas desde Server Actions/Route Handlers) ──
RESEND_API_KEY=

# API de catálogo (backend/, servicio Prisma/Postgres) — ver backend/.env.example
# para levantarla. API_KEY es la credencial general; RELAYER_API_KEY solo hace
# falta acá si esta app también registra pagos directamente (normalmente no).
CATALOG_API_URL=http://localhost:3002
API_KEY=
RELAYER_API_KEY=

# Relayer gasless (backend/, servicio de pagos) — ver backend/.env.example.
RELAYER_URL=http://localhost:3001
# Debe coincidir con ADMIN_API_KEY del backend: habilita el alta de comercios.
RELAYER_ADMIN_API_KEY=

# Tesorería que patrocina el alta de comercios desde el frontend. Transitorio:
# con el alta a través del relayer (POST /merchants) el comercio ya no
# necesita SOL y esta variable deja de hacer falta.
TREASURY_SECRET_KEY=
